{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Ditfa Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/ditfa-vscode"],
      "outFiles": ["${workspaceFolder}/ditfa-vscode/dist/**/*.js"],
      "preLaunchTask": "ditfa: watch"
    }
  ]
}
