{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ditfa: watch",
      "type": "shell",
      "command": "pnpm run watch",
      "options": { "cwd": "${workspaceFolder}/ditfa-vscode" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": {
          "regexp": "^\\s*(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[esbuild\\] watching",
          "endsPattern": "\\[esbuild\\] (built|watching)"
        }
      }
    }
  ]
}
