{
  "name": "ditfa-ide",
  "version": "0.4.0",
  "private": true,
  "description": "Ditfa Code: the Ditfa coding agent for VS Code and the editors built on it.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditfa-dev/ditfa-ide.git"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter ditfa-code run build",
    "compile": "pnpm --filter ditfa-code run compile",
    "watch": "pnpm --filter ditfa-code run watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "pnpm --filter ditfa-code run package",
    "sync-protocol": "node scripts/sync-protocol.mjs",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^20.19.18",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "0.28.1",
    "ovsx": "^0.10.1",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}
